# Public Supabase client config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alternate public key name used by some Supabase/Vercel setups
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Required only if you want instant confirmed mobile signup
SUPABASE_SERVICE_ROLE_KEY=

# Preferred generic SMTP config
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Stree Orders <info@streesarees.com>

# Inbox for website contact and new-order alerts
MAIL_TO=info@streesarees.com

# Optional legacy aliases still supported by the mail helper
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
ORDER_NOTIFICATION_EMAIL=info@streesarees.com
