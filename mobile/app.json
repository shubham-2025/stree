{
  "expo": {
    "name": "Stree Sarees",
    "slug": "stree-sarees",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "streesarees",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF7F2",
    "splash": {
      "image": "./assets/images/splash.png",
      "backgroundColor": "#FAF7F2",
      "resizeMode": "contain"
    },
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "barStyle": "light-content",
      "translucent": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.streesarees.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "package": "com.streesarees.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
