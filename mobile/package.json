{
  "name": "stree-sarees-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas:login": "npx eas-cli login",
    "eas:whoami": "npx eas-cli whoami",
    "eas:init": "npx eas-cli init",
    "eas:env:list": "npx eas-cli env:list",
    "eas:credentials:android": "npx eas-cli credentials --platform android",
    "eas:build:android:preview": "npx eas-cli build --platform android --profile preview",
    "eas:build:android:production": "npx eas-cli build --platform android --profile production",
    "eas:build:android:production:local": "npx eas-cli build --platform android --profile production --local",
    "eas:submit:android:internal": "npx eas-cli submit --platform android --profile internal",
    "eas:submit:android:production": "npx eas-cli submit --platform android --profile production",
    "eas:build-and-submit:android:internal": "npx eas-cli build --platform android --profile production --auto-submit-with-profile internal"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "axios": "^1.16.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^20.17.57",
    "@types/react": "~19.1.10",
    "tailwindcss": "3.4.17",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
