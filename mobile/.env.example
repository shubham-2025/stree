# Supabase Auth config for the mobile app
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_public_publishable_key

# Backend API base URL (must end with /api).
# Local emulator (Android): http://10.0.2.2:3000/api
# Local device on Wi-Fi:    http://YOUR-LAN-IP:3000/api
# Production / Play builds: https://stree-sarees-com.vercel.app/api
EXPO_PUBLIC_API_URL=https://stree-sarees-com.vercel.app/api

# Optional QA-only demo login.
# Leave these unset for production Play Store builds.
# EXPO_PUBLIC_ENABLE_DEMO_LOGIN=true
# EXPO_PUBLIC_DEMO_EMAIL=reviewer@example.com
# EXPO_PUBLIC_DEMO_PASSWORD=StrongPassword123
